# Copy this file to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Hidden admin dashboard (server-only — never prefix these with NEXT_PUBLIC_) ──
# Secret URL segment: the dashboard lives at https://sportsrankings.world/<ADMIN_PATH>
# Use 12+ random URL-safe characters, e.g. the output of:  openssl rand -hex 12
ADMIN_PATH=
# Signs login sessions. 32+ random characters:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Supabase → Settings → API → service_role / secret key. Reads/writes the private ds_* tables.
SUPABASE_SERVICE_KEY=

# ── Website traffic report (admin "Website traffic" tab) — server-only ──
# Vercel → Account settings → Tokens: create a token scoped to the WSR team.
VERCEL_API_TOKEN=
# Team settings → General → Team ID (team_…), and wsr-website → Settings → General → Project ID (prj_…)
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
